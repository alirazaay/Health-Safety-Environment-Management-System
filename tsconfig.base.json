{
  "compilerOptions": {
    "target": "ES2022",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@cbl/api": ["packages/api/src/index.ts"],
      "@cbl/auth": ["packages/auth/src/index.tsx"],
      "@cbl/config": ["packages/config/src/index.ts"],
      "@cbl/database": ["packages/database/src/index.ts"],
      "@cbl/types": ["packages/types/src/index.ts"],
      "@cbl/ui": ["packages/ui/src/index.tsx"],
      "@cbl/ui/*": ["packages/ui/src/*"],
      "@cbl/utils": ["packages/utils/src/index.ts"]
    }
  }
}
